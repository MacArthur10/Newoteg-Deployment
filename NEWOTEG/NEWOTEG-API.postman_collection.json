{
  "info": {
    "name": "NEWOTEG E-Commerce API",
    "description": "Complete API collection for NEWOTEG single-store e-commerce backend with admin and customer endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "variantId",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', response.access_token);",
                  "    pm.environment.set('adminToken', response.access_token);",
                  "    console.log('Admin token saved:', response.access_token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with admin credentials. Token is automatically saved to collection variables."
          },
          "response": []
        },
        {
          "name": "Customer Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('customerToken', response.access_token);",
                  "    pm.environment.set('customerToken', response.access_token);",
                  "    console.log('Customer token saved:', response.access_token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer{{$timestamp}}@test.com\",\n  \"password\": \"Password123\",\n  \"fullName\": \"Test Customer\",\n  \"phone\": \"+1234567890\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new customer. Token is automatically saved. Email uses timestamp to ensure uniqueness."
          },
          "response": []
        },
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('customerToken', response.access_token);",
                  "    pm.environment.set('customerToken', response.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@test.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login with existing customer credentials."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Public Products",
      "item": [
        {
          "name": "List All Products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const products = pm.response.json();",
                  "    if (products.length > 0) {",
                  "        pm.collectionVariables.set('productId', products[0].id);",
                  "        if (products[0].variants && products[0].variants.length > 0) {",
                  "            pm.collectionVariables.set('variantId', products[0].variants[0].id);",
                  "            console.log('Product ID:', products[0].id);",
                  "            console.log('Variant ID:', products[0].variants[0].id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Get all active products with variants. No authentication required. Automatically saves first product and variant IDs."
          },
          "response": []
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Get detailed information about a specific product including all variants. No authentication required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Customer Reservations",
      "item": [
        {
          "name": "Create Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const reservation = pm.response.json();",
                  "    pm.collectionVariables.set('reservationId', reservation.id);",
                  "    console.log('Reservation ID:', reservation.id);",
                  "    console.log('Total Amount:', reservation.totalAmount);",
                  "    console.log('Expires At:', reservation.expiresAt);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"variantId\": \"{{variantId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["reservations"]
            },
            "description": "Create a new reservation with product variants. Requires customer authentication. Returns complete pricing information including unitPrice and totalPrice per item."
          },
          "response": []
        },
        {
          "name": "Get My Reservations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/me",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "me"]
            },
            "description": "Get all reservations for the logged-in customer with full pricing details."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Admin - Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard"]
            },
            "description": "Get admin dashboard statistics including total products, variants, reservations, and revenue."
          },
          "response": []
        },
        {
          "name": "Get Revenue Analytics",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/analytics/revenue",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "analytics", "revenue"]
            },
            "description": "Get revenue breakdown by reservation status (PENDING, CONFIRMED, CANCELLED, EXPIRED)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Admin - Products",
      "item": [
        {
          "name": "Get All Products (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products"]
            },
            "description": "Get all products including inactive ones with complete variant information."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const product = pm.response.json();",
                  "    pm.collectionVariables.set('productId', product.id);",
                  "    console.log('New Product ID:', product.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Product {{$timestamp}}\",\n  \"description\": \"A test product created via Postman\",\n  \"category\": \"Electronics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Create a new product. Admin authentication required."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product Name\",\n  \"description\": \"Updated description\",\n  \"category\": \"Electronics\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Update an existing product. All fields are optional."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            },
            "description": "Soft delete a product (marks as inactive)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Admin - Product Variants",
      "item": [
        {
          "name": "Create Variant",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const variant = pm.response.json();",
                  "    pm.collectionVariables.set('variantId', variant.id);",
                  "    console.log('New Variant ID:', variant.id);",
                  "    console.log('SKU:', variant.sku);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"SKU-{{$timestamp}}\",\n  \"price\": 299.99,\n  \"stock\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}/variants",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}", "variants"]
            },
            "description": "Create a new variant for a product. SKU is optional (will be auto-generated)."
          },
          "response": []
        },
        {
          "name": "Update Variant",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 349.99,\n  \"stock\": 75,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/variants/{{variantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "variants", "{{variantId}}"]
            },
            "description": "Update a variant. All fields are optional."
          },
          "response": []
        },
        {
          "name": "Delete Variant",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/variants/{{variantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "variants", "{{variantId}}"]
            },
            "description": "Soft delete a variant (marks as inactive)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "7. Admin - Reservations",
      "item": [
        {
          "name": "Get All Reservations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/admin/all",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "admin", "all"]
            },
            "description": "Get all reservations with customer details and complete pricing information (unitPrice, totalPrice per item, totalAmount for reservation)."
          },
          "response": []
        },
        {
          "name": "Update Reservation Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["reservations", "{{reservationId}}", "status"]
            },
            "description": "Update reservation status. Valid statuses: PENDING, CONFIRMED, CANCELLED, EXPIRED. Cancelling restores stock automatically."
          },
          "response": []
        },
        {
          "name": "Get Admin Reservations List",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/reservations",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "reservations"]
            },
            "description": "Get all reservations with full customer and pricing details including unitPrice, totalPrice, and SKU information."
          },
          "response": []
        }
      ]
    },
    {
      "name": "8. Admin - Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            },
            "description": "Get all users in the system with their roles (ADMIN, CUSTOMER, CASHIER)."
          },
          "response": []
        }
      ]
    }
  ]
}